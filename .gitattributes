# KiCad writes LF on every platform; keep the working copy LF so files
# saved or re-exported on Windows don't show as modified.

# Design files
*.kicad_pcb   text eol=lf
*.kicad_sch   text eol=lf
*.kicad_pro   text eol=lf
*.kicad_prl   text eol=lf
*.kicad_sym   text eol=lf
*.kicad_mod   text eol=lf
*.kicad_dru   text eol=lf
*.kicad_wks   text eol=lf
fp-lib-table  text eol=lf
sym-lib-table text eol=lf

# Fabrication and 3D outputs
*.gbr         text eol=lf
*.gbrjob      text eol=lf
*.drl         text eol=lf
*.step        text eol=lf
